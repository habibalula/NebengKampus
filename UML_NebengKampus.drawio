  <diagram id="wTzb4cROqbx7Ix34HT9_" name="Page-7">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - Menerima Pembayaran\n\nautonumber 1\n\nactor \&quot;Driver\&quot; as Driver\nboundary \&quot;UI Pembayaran\&quot; as UI\ncontrol \&quot;Sistem Pembayaran\&quot; as Sistem\ndatabase \&quot;Database\&quot; as DB\nactor \&quot;Penumpang\&quot; as Penumpang\n\nactivate Driver\n\n&#39; FASE 1: INISIASI PENYELESAIAN PERJALANAN &amp; KALKULASI TAGIHAN\nDriver -&gt; UI : Klik \&quot;Selesaikan Perjalanan\&quot; ()\nactivate UI\n\nUI -&gt; Sistem : Selesaikan Perjalanan (order_id, driver_id)\nactivate Sistem\n\nSistem -&gt; DB : Query Detail Perjalanan &amp; Kalkulasi Biaya (order_id)\nactivate DB\n\nDB --&gt; Sistem : Return Data Rute &amp; Total Biaya Operasional ()\ndeactivate DB\n\nSistem --&gt; UI : Tampilkan Rincian Tagihan pada Layar Driver &amp; Penumpang ()\ndeactivate Sistem\ndeactivate UI\n\n&#39; FASE 2: PELAKSANAAN PEMBAYARAN DIRECT\nUI --&gt; Penumpang : Tampilkan Rincian Biaya &amp; Instruksi Pembayaran ()\nactivate Penumpang\n\nPenumpang -&gt; Driver : Lakukan Pembayaran (Tunai / Transfer Direct)\ndeactivate Penumpang\n\nDriver -&gt; UI : Periksa &amp; Pilih Status Penerimaan Uang ()\nactivate UI\n\n&#39; FASE 3: VALIDASI &amp; UPDATE STATUS (ALT FRAME)\nUI -&gt; Sistem : Kirim Status Penerimaan ()\nactivate Sistem\n\nalt Kondisi 1: Pembayaran Diterima / Lunas\n    Driver -&gt; UI : Klik \&quot;Konfirmasi Pembayaran Diterima\&quot; ()\n    UI -&gt; Sistem : Submit Konfirmasi Lunas (order_id, status=\&quot;Lunas\&quot;)\n    \n    Sistem -&gt; DB : Update Status Pembayaran = \&quot;Lunas\&quot; (Tabel Pembayaran)\n    activate DB\n    Sistem -&gt; DB : Update Status Perjalanan = \&quot;Selesai\&quot; (Tabel Pelaksanaan Pesanan)\n    DB --&gt; Sistem : Konfirmasi Data Berhasil Diperbarui ()\n    deactivate DB\n    \n    Sistem --&gt; UI : Return Status \&quot;Transaksi Berhasil &amp; Resi Digital\&quot; ()\n    UI --&gt; Driver : Tampilkan Notifikasi Sukses &amp; Buka Layar \&quot;Beri Rating Penumpang\&quot; ()\n    UI --&gt; Penumpang : Kirim Push Notification Transaksi Lunas &amp; Buka Layar \&quot;Beri Rating Pengemudi\&quot; ()\n\nelse Kondisi 2: Pembayaran Belum Diterima / Ada Kendala\n    Driver -&gt; UI : Klik \&quot;Laporkan Kendala Pembayaran\&quot; ()\n    UI -&gt; Sistem : Submit Tiket Kendala Pembayaran (order_id, alasan)\n    \n    Sistem -&gt; DB : Simpan Tiket Kendala &amp; Hold Status Otomatis ()\n    activate DB\n    DB --&gt; Sistem : Konfirmasi Tiket Tersimpan ()\n    deactivate DB\n    \n    Sistem --&gt; UI : Tampilkan Pesan \&quot;Laporan Dikirimkan ke Admin\&quot; ()\n    UI --&gt; Driver : Tampilkan Konfirmasi Laporan Dikirim ()\nend\n\ndeactivate Sistem\ndeactivate UI\ndeactivate Driver\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VpleM4KkXeJtRmecb0rm-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
